# артефакты сборки и запуска
.idea
.check_tmp/
*.produced
solution
*.o
*.obj
*.exe
__pycache__/
*.pyc

# решение студента (создаётся локально, не коммитится в шаблон)
solution.json

# ПРИВАТНОЕ преподавателя — никогда не коммитить в публичный репозиторий:
reference.*
main.cpp
*_reference.*
tests/hidden/
TEACHER.md
program.md

# генератор р2 — выдаёт готовую реализацию чтения/записи BMP (это сами
# студенты обязаны написать самостоятельно); раздаются только результаты
# его работы (shuffled.bmp + keys.txt), не исходники и не бинарник
# (чекер публичных тестов — r2-bmp-sort/check_restore.py, на чистом Python,
# от bmpshuffle не зависит)
r2-bmp-sort/tools/
r2-bmp-sort/orig-c-generator/

# эталоны р2 — исходные (неперемешанные) изображения для реальных
# вариантов; студентам выдаются только shuffled.bmp + keys.txt на руки,
# сами оригиналы остаются только у преподавателя для приёмки
r2-bmp-sort/source-bmp/

# персональные варианты р2 — выдаются каждому студенту отдельно (не через
# публичный репозиторий); assignment.csv вдобавок раскрывает, кому какой
# алгоритм достался, и список группы
r2-bmp-sort/variants/
r2-bmp-sort/spisok.txt

# персональные варианты р3 — выдаются каждому студенту отдельно (не через
# публичный репозиторий); assignment.csv раскрывает список группы и кому
# какой вариант; acceptance/ — эталонные ответы на персональные входы
r3-spam-filter/variants/
r3-spam-filter/acceptance/

# р3: инструменты преподавателя — генераторы тестов/вариантов/методички,
# эталонное C++-решение и его намеренно сломанные сборки
r3-spam-filter/teacher/
# конспекты лекций — живут вне публичного репозитория
Лекция_*

# персональные варианты ДЗ1 — раздаются лично; assignment.csv раскрывает
# список группы (общий с р3: одна хеш-таблица на обе работы)
hw1-dict/variants/
# ДЗ1: инструменты преподавателя — генератор тестов, проверочное решение
# с намеренными ошибками
hw1-dict/teacher/

# генератор лабиринтов р4 (Go) — инструмент преподавателя: в maze/ есть
# решатель и вывод PNG/SVG (это студенты пишут сами); раздаются только
# готовые лабиринты. Плюс эталоны, персональные варианты и инструменты р4.
r4-maze/mazeGenerator/
r4-maze/variants/
r4-maze/acceptance/
r4-maze/teacher/

# р5: эталон, персональные входы, эталоны приёмки, инструменты преподавателя
r5-scanner/variants/
r5-scanner/acceptance/
r5-scanner/teacher/
